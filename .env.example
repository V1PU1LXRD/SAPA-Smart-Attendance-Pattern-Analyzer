# =========================================
# SAPA — Environment Variables
# =========================================
# Copy this file to server/.env and fill in
# your actual values. Never commit .env files.
# =========================================

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sapa?retryWrites=true&w=majority

# JWT Secret (use a random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Email Configuration (for OTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173